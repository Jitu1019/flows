# Copy to .env and fill in. .env is git-ignored: never commit it.
# Test numbers log in with the bypass code in every environment, production included.

# auth-journey: the test account. One of auth-service's OTP_TEST_MOBILE numbers,
# 10 digits, no country code.
ZOOP_TEST_MOBILE=
# auth-service OTP_BYPASS_CODE (998877 against a local auth-service with OTP_LIVE=false).
ZOOP_TEST_OTP=

# chat-session: comma-separated test numbers that log in with ZOOP_TEST_OTP.
# Each chat session picks one at random.
ZOOP_CHAT_MOBILES=
